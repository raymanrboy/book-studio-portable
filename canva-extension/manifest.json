{
  "manifest_version": 3,
  "name": "Book Studio → Canva",
  "version": "0.1.0",
  "description": "Розкладає картинки й текст книги з Майстерні Book Studio по шаблону Canva.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.canva.com/*"],
      "js": ["book.js", "canva.js", "panel.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
