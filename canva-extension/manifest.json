{
  "manifest_version": 3,
  "name": "Book Studio → Canva",
  "version": "0.4.0",
  "description": "Книга з Майстерні Book Studio в шаблоні Canva (картинки й текст) і копія шаблону під замовлення.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.canva.com/*"
      ],
      "js": [
        "early.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.canva.com/*"
      ],
      "js": [
        "book.js",
        "canva.js",
        "order.js",
        "panel.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}